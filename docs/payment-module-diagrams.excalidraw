      "opacity": 100,
      "originalText": "// NestJS -> Effect bridge via Context.Tag\nexport const DbClientTag = Context.Service<\n  DbClientTag, DbExecutor\n>()('phsarkhmer/db/DbClient');\n\n// Layer.mergeAll builds processor context\nconst layer = Layer.mergeAll(\n  DbClientTag.layer(this.db),\n  PaymentGatewayRegistryTag.layer(this.registry)\n);",
      "roughness": 1,
      "roundness": null,
      "seed": 1060384184,
      "strokeColor": "#616161",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "// NestJS -> Effect bridge via Context.Tag\nexport const DbClientTag = Context.Service<\n  DbClientTag, DbExecutor\n>()('phsarkhmer/db/DbClient');\n\n// Layer.mergeAll builds processor context\nconst layer = Layer.mergeAll(\n  DbClientTag.layer(this.db),\n  PaymentGatewayRegistryTag.layer(this.registry)\n);",
