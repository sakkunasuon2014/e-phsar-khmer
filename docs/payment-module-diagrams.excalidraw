      "containerId": "p1-code",
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 10,
      "frameId": null,
      "groupIds": [],
      "index": "a72",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "// Every use case uses Effect.fn\nconst createPayment = Effect.fn('createPayment')(\n  function* (input: CreatePaymentInput) {\n    const rows = yield* Effect.tryPromise({\n      try: () => db.insert(...).returning(),\n      catch: (cause) => toCreatePaymentError(cause)\n    });\n    return rows[0];\n  }\n);",
      "roughness": 1,
      "roundness": null,
      "seed": 1389996615,
      "strokeColor": "#616161",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "// Every use case uses Effect.fn\nconst createPayment = Effect.fn('createPayment')(\n  function* (input: CreatePaymentInput) {\n    const rows = yield* Effect.tryPromise({\n      try: () => db.insert(...).returning(),\n      catch: (cause) => toCreatePaymentError(cause)\n    });\n    return rows[0];\n  }\n);",
      "textAlign": "center",
      "updated": 1789638315613,
      "version": 1,
      "versionNonce": 1044888491,
      "verticalAlign": "middle"
    },
