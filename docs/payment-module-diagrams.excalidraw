      "opacity": 100,
      "originalText": "// Two error universes, never mixed\nexport class PaymentTransactionNotFoundError extends\n  Schema.TaggedError<PaymentTransactionNotFoundError>()(\n    'PaymentTransactionNotFoundError', { message: Schema.String }\n  ) {}",
