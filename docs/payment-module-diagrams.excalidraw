      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "// Every write path uses runDurably\nasync runDurably(build) {\n  return this.run(\n    runInTransaction(\n      (db) => {\n        const effect = build(db, outboxService);\n        return Effect.provide(effect, DbClientTag.layer(db));\n      }\n    )\n  ).then(() => outboxService.wakeupAfterCommit());\n}",
      "roughness": 1,
      "roundness": null,
      "seed": 1670855093,
      "strokeColor": "#616161",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "// Every write path uses runDurably\nasync runDurably(build) {\n  return this.run(\n    runInTransaction(\n      (db) => {\n        const effect = build(db, outboxService);\n        return Effect.provide(effect, DbClientTag.layer(db));\n      }\n    )\n  ).then(() => outboxService.wakeupAfterCommit());\n}",
