# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=
# Max postgres.js pool connections, shared by the whole backend (default 20).
# Raise if concurrent chat/API traffic starts queueing for a free connection.
DATABASE_POOL_MAX=

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

QUEUE_HOST=localhost
QUEUE_PORT=6379
QUEUE_PASSWORD=
QUEUE_DB=0
QUEUE_PREFIX=phsar

# Payment job retry policy (BullMQ side)
PAYMENT_JOB_ATTEMPTS=3
PAYMENT_JOB_BACKOFF_MS=5000
PAYMENT_WORKER_CONCURRENCY=5

# ABA PayWay gateway
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Publicly reachable — this is the `return_url` ABA is told to POST payment
# results to on every purchase call, i.e. this backend's own
# /api/v1/payments/webhooks/aba-payway route, not a browser redirect. Required:
# ABA is webhook-only, so without it ABA is unavailable at checkout.
ABA_PAYWAY_WEBHOOK_URL=
# Minutes a checkout stays payable (min 3). ABA rejects payment after it;
# ABA's own default would be 30 days.
ABA_PAYWAY_LIFETIME_MINUTES=15

# Bakong KHQR. Unlike ABA, there is no create-transaction network call — the
# fields below feed the bakong-khqr SDK's local, offline KHQR generation;
# BAKONG_API_KEY (a bearer token from Bakong's developer portal) is only
# used to poll check_transaction_by_md5 for the payment outcome.
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_KEY=
# 'individual' needs only ACCOUNT_ID + MERCHANT_NAME (a personal Bakong
# account alias, e.g. "yourname@bank" — no business registration required).
# 'merchant' additionally needs MERCHANT_ID + ACQUIRING_BANK, issued by a
# participating bank/PSP through merchant onboarding.
BAKONG_MERCHANT_TYPE=individual
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
# Only needed when BAKONG_MERCHANT_TYPE=merchant.
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_QR_EXPIRY_SECONDS=300
# Bakong delivers no webhooks — this is the delay between poll-attempt jobs
# re-checking check_transaction_by_md5 (see
# src/payment/providers/bakong/README.md).
BAKONG_POLL_INTERVAL_MS=4000
