# Trim the upload for the backend container build. The Docker context and the
# Vercel upload are the same set of files, so everything here must also be
# absent from the image build — see .dockerignore.
#
# packages/* must NOT be excluded: pnpm-workspace.yaml globs packages/* and
# `pnpm install --frozen-lockfile` in Dockerfile.vercel validates every
# workspace importer in pnpm-lock.yaml against a matching package.json.
# The same goes for apps/web — see the note at the bottom.
.turbo
**/.next
**/coverage
**/*.log
graphify-out
docs
tasks
.claude
.pipeline
.opencode
.idea
.vscode

# apps/web must NOT be excluded: this file is read by every Vercel project
# built from this repo, including the web project (Root Directory = apps/web).
# Excluding it removes apps/web/package.json from the build and fails with
# NEXT_NO_VERSION. The backend's Docker build is unaffected — pnpm runs
# `--filter backend...` — it just uploads ~257 MB instead of ~10 MB.
